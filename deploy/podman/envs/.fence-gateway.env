# fence-gateway runtime environment. Copy real secrets in out-of-band; do not
# commit filled-in values.

# Serve the Streamable HTTP transport on this port (unset would mean stdio,
# which is not what a container deployment wants).
MCP_PORT=8080

# Downstream client auth — the token(s) clients present TO the gateway.
# Mandatory in HTTP mode. Use MCP_AUTH_TOKEN for one, or MCP_AUTH_TOKENS for a
# comma-separated identity:token list. Generate with `openssl rand -hex 32`.
MCP_AUTH_TOKEN=CHANGEME_openssl_rand_hex_32
#MCP_AUTH_TOKENS=alice:CHANGEME1,bob:CHANGEME2

# The token the gateway presents TO the upstream relay (the relay's own MCP auth
# token). Opposite direction from the client tokens above. Omit if the relay
# needs no auth.
UPSTREAM_MCP_TOKEN=CHANGEME_the_relays_MCP_AUTH_TOKEN

# Optional: serve HTTPS directly (mount the cert/key into the container). Both
# or neither. Otherwise terminate TLS at a reverse proxy in front.
#MCP_TLS_CERT=/etc/gateway-tls/tls.crt
#MCP_TLS_KEY=/etc/gateway-tls/tls.key

# Optional: OAuth 2.0 / OIDC verification of client JWTs, instead of / alongside
# MCP_AUTH_TOKEN. Setting the issuer enables it; the audience is then required.
# See the repo README, "Running remotely".
#MCP_OAUTH_ISSUER=https://idp.example.com/realms/main
#MCP_OAUTH_AUDIENCE=https://gateway.example.com
#MCP_OAUTH_IDENTITY_CLAIM=sub
#MCP_OAUTH_REQUIRED_SCOPE=
